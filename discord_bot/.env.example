# Discord Developer Portal → your application → Bot → Token
DISCORD_BOT_TOKEN=your-bot-token-here

# Discord Developer Portal → your application → General Information → Application ID
DISCORD_APPLICATION_ID=0

# Optional: a guild (server) ID for instant per-guild slash-command sync in
# development. Leave at 0 (or unset) to sync commands globally instead,
# which Discord can take up to an hour to propagate.
DISCORD_GUILD_ID=0

# Base URL of the running GuildDesk FastAPI backend (no trailing slash,
# no /api/v1 suffix — /health is mounted at the bare root, not under the
# versioned API prefix).
API_URL=http://127.0.0.1:8000
