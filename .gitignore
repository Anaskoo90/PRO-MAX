.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# --- Logs ---
*.log

# --- Environment files (never commit real secrets) ---
.env
.env.*
!.env.example
discord_bot/.env
services/platform/.env

# --- Local runtime data ---
.local-storage/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
