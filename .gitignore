# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/

# --- uv ---
# uv.lock is intentionally NOT ignored — it's committed for reproducible installs.
.uv/

