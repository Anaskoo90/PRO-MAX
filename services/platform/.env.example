ENVIRONMENT=local
SERVICE_NAME=guilddesk-platform

DATABASE_URL=postgresql+asyncpg://guilddesk:guilddesk@localhost:5432/guilddesk
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

API_VERSION=v1
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

OTEL_EXPORTER_ENDPOINT=

# Local dev only — see platform_core/security/secrets_provider.py
GUILDDESK_SECRET_JWT_SIGNING_KEY=dev-only-change-me
