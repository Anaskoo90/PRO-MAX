ENVIRONMENT=local
SERVICE_NAME=guilddesk-platform
# Development values only. Generate independent random values for every
# deployed environment and keep them in its secret manager.
GUILDDESK_SECRET_JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
GUILDDESK_SECRET_TOKEN_HASH_PEPPER=replace-with-at-least-32-random-characters
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GUILDDESK_SECRET_FIELD_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

DATABASE_URL=postgresql+asyncpg://guilddesk:guilddesk@localhost:5432/guilddesk
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

API_VERSION=v1
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
WEB_APP_BASE_URL=http://localhost:5173

# Local Docker Compose runs Mailpit on these ports. For staging/production,
# use the credentials and TLS mode supplied by the transactional-email host.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@guilddesk.local
SMTP_FROM_NAME=GuildDesk
SMTP_USE_SSL=false
SMTP_START_TLS=false
SMTP_TIMEOUT_SECONDS=10

# Optional Discord OAuth login. Leave all three blank to disable the provider.
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_DISCORD_REDIRECT_URI=

OTEL_EXPORTER_ENDPOINT=

# Required in every environment. Generate at least 32 random bytes and keep
# the value in your secret manager; do not commit a real key.
GUILDDESK_SECRET_JWT_SIGNING_KEY=
