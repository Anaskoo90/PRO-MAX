ENVIRONMENT=local
SERVICE_NAME=guilddesk-platform

DATABASE_URL=postgresql+asyncpg://guilddesk:guilddesk@localhost:5432/guilddesk
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

API_VERSION=v1
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
WEB_APP_BASE_URL=http://localhost:5173

# Local Docker Compose runs Mailpit on these ports. For staging/production,
# use the credentials and TLS mode supplied by the transactional-email host.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@guilddesk.local
SMTP_FROM_NAME=GuildDesk
SMTP_USE_SSL=false
SMTP_START_TLS=false
SMTP_TIMEOUT_SECONDS=10

OTEL_EXPORTER_ENDPOINT=

# Required in every environment. Generate at least 32 random bytes and keep
# the value in your secret manager; do not commit a real key.
GUILDDESK_SECRET_JWT_SIGNING_KEY=
