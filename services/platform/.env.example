ENVIRONMENT=local
SERVICE_NAME=guilddesk-platform
# Development values only. Generate independent random values for every
# deployed environment and keep them in its secret manager.
GUILDDESK_SECRET_JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
GUILDDESK_SECRET_TOKEN_HASH_PEPPER=replace-with-at-least-32-random-characters
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GUILDDESK_SECRET_FIELD_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

DATABASE_URL=postgresql+asyncpg://guilddesk:guilddesk@localhost:5432/guilddesk
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

API_VERSION=v1
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
WEB_APP_BASE_URL=http://localhost:5173

# Local Docker Compose runs Mailpit on these ports. For staging/production,
# use the credentials and TLS mode supplied by the transactional-email host.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@guilddesk.local
SMTP_FROM_NAME=GuildDesk
SMTP_USE_SSL=false
SMTP_START_TLS=false
SMTP_TIMEOUT_SECONDS=10

# Optional Discord OAuth login. Leave all three blank to disable the provider.
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_DISCORD_REDIRECT_URI=

# Discord bot setup/integration. The backend and discord_bot deployment
# must use the same service secret; replace this development value in every
# staging/production environment.
DISCORD_APPLICATION_ID=
GUILDDESK_SECRET_DISCORD_BOT_SERVICE_SECRET=dev-only-change-me

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./.local-storage
# For S3-compatible storage (AWS S3, MinIO, etc.). Endpoint and static
# credentials may be blank when the deployment uses AWS IAM credentials.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional AI Gateway. Keep disabled unless at least one provider key is
# available. The API selects configured models server-side; clients cannot
# override provider or model and therefore cannot bypass cost policy.
AI_PROVIDER=disabled
AI_FALLBACK_PROVIDER=
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o-mini
AI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_OPENAI_EMBEDDING_DIMENSIONS=1536
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
AI_ANTHROPIC_MODEL=claude-3-5-haiku-latest
AI_ANTHROPIC_VERSION=2023-06-01
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=4096
AI_REQUESTS_PER_MINUTE=20
AI_MAX_PROMPT_CHARACTERS=50000

OTEL_EXPORTER_ENDPOINT=

# Required in every environment. Generate at least 32 random bytes and keep
# the value in your secret manager; do not commit a real key.
GUILDDESK_SECRET_JWT_SIGNING_KEY=
